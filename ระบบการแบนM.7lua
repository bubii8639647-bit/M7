-- ==========================================
-- [ตั้งค่าระบบ SafeGuard]
-- ==========================================
local Config = {
    Enabled = true,
    CheckInterval = 1.5,     -- เช็กความปลอดภัยทุกๆ 1.5 วินาที
    MaxWalkSpeed = 24,       -- จำกัดความเร็วสูงสุด (กันโดนจับ Speed)
    MaxJumpPower = 55,       -- จำกัดความสูงกระโดดสูงสุด
    SafeRadius = 25,         -- ระยะห่างจากผู้เล่นอื่น (เมตร)
    AntiAFK = true,          -- เปิดระบบขยับตัวกันโดนเตะเวลาเปิดบอททิ้งไว้
    AdminIds = { [123456] = true }, -- ใส่ UserId แอดมินที่ต้องการระวัง
    DangerRoles = { "admin", "mod", "staff", "owner", "dev" }
}

-- ตัวแปรกลาง (ใช้เชื่อมกับสคริปต์อื่นได้)
getgenv().IsSafeToRun = true

local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- ==========================================
-- [1. สร้างหน้าต่างแจ้งเตือนสถานะมุมจอ (Mini Status UI)]
-- ==========================================
if CoreGui:FindFirstChild("SafeGuardUI") then
    CoreGui.SafeGuardUI:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "SafeGuardUI"
ScreenGui.Parent = CoreGui

local StatusLabel = Instance.new("TextLabel")
StatusLabel.Parent = ScreenGui
StatusLabel.Size = UDim2.new(0, 220, 0, 35)
StatusLabel.Position = UDim2.new(0, 15, 0, 15) -- มุมซ้ายบน
StatusLabel.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
StatusLabel.BackgroundTransparency = 0.2
StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
StatusLabel.Font = Enum.Font.GothamBold
StatusLabel.TextSize = 13
StatusLabel.Text = "🛡️ SafeGuard: ปลอดภัย (ทำงานปกติ)"

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = StatusLabel

local function UpdateUI(isSafe, reason)
    if isSafe then
        StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 120)
        StatusLabel.Text = "🛡️ SafeGuard: ปลอดภัย"
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
        StatusLabel.Text = "⚠️ หยุดชั่วคราว: " .. (reason or "ไม่ปลอดภัย")
    end
end

-- ==========================================
-- [2. ระบบ Anti-AFK (กันเกมเตะออกเมื่อครบ 20 นาที)]
-- ==========================================
if Config.AntiAFK then
    LocalPlayer.Idled:Connect(function()
        VirtualUser:CaptureController()
        VirtualUser:ClickButton2(Vector2.new())
    end)
end

-- ==========================================
-- [3. ระบบตรวจสอบและป้องกันอัตโนมัติ (เบื้องหลัง)]
-- ==========================================
task.spawn(function()
    while Config.Enabled do
        local isSafe = true
        local warningReason = ""
        
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        -- ควบคุมค่า Speed / Jump ไม่ให้เกินลิมิต
        if hum then
            if hum.WalkSpeed > Config.MaxWalkSpeed then
                hum.WalkSpeed = Config.MaxWalkSpeed
            end
            if hum.JumpPower > Config.MaxJumpPower then
                hum.JumpPower = Config.MaxJumpPower
            end
        end

        -- ตรวจสอบผู้เล่นคนอื่นในเซิร์ฟเวอร์
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                -- เช็ก ID แอดมิน
                if Config.AdminIds[plr.UserId] then
                    isSafe = false
                    warningReason = "พบแอดมิน!"
                    break
                end

                -- เช็กชื่อหรือยศต้องสงสัย
                local pName = string.lower(plr.Name)
                local dName = string.lower(plr.DisplayName)
                for _, role in ipairs(Config.DangerRoles) do
                    if string.find(pName, role) or string.find(dName, role) then
                        isSafe = false
                        warningReason = "พบชื่อต้องสงสัย (" .. plr.Name .. ")"
                        break
                    end
                end

                -- เช็กระยะห่างผู้เล่นอื่น
                if isSafe and hrp and plr.Character then
                    local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")
                    if targetHrp then
                        local dist = (hrp.Position - targetHrp.Position).Magnitude
                        if dist <= Config.SafeRadius then
                            isSafe = false
                            warningReason = "มีคนเข้าใกล้ (" .. math.floor(dist) .. "m)"
                            break
                        end
                    end
                end
            end
        end

        -- อัปเดตสถานะทั้งตัวแปรกลางและหน้าจอ UI
        getgenv().IsSafeToRun = isSafe
        UpdateUI(isSafe, warningReason)

        task.wait(Config.CheckInterval + (math.random() * 0.4))
    end
end)

